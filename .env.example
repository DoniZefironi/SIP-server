# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

TELEPHONY_LOG_LEVEL=INFO

# Cookie передаются браузером по HTTPS через прокси одного домена с фронтендом.
TELEPHONY_AUTH_SECURE_COOKIES=true

# База данных (контейнер db из docker-compose.yml)
TELEPHONY_DB_HOST=127.0.0.1
TELEPHONY_DB_PORT=5432
TELEPHONY_DB_NAME=telephony
TELEPHONY_DB_USER=telephony
TELEPHONY_DB_PASSWORD=change-me

# AMI — интерфейс событий Asterisk (пользователь из /etc/asterisk/manager.conf).
# На машине без Asterisk поставить TELEPHONY_AMI_ENABLED=false.
TELEPHONY_AMI_ENABLED=true
TELEPHONY_AMI_HOST=127.0.0.1
TELEPHONY_AMI_PORT=5038
TELEPHONY_AMI_USERNAME=telephony
TELEPHONY_AMI_SECRET=change-me

# Записи разговоров и сообщения. На сервере: номер группы asterisk —
# вывод команды «getent group asterisk | cut -d: -f3».
TELEPHONY_ASTERISK_GID=65534
TELEPHONY_RECORDINGS_RETENTION_DAYS=365
# На компьютере без папки записей обслуживание можно выключить.
TELEPHONY_MAINTENANCE_ENABLED=true
# Сохранять в PostgreSQL задачи для готовых записей завершённых звонков.
TELEPHONY_RECORDING_QUEUE_ENABLED=true

# Включает отправку готовых записей из очереди в Yandex SpeechKit.
# API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user.
TELEPHONY_SPEECHKIT_ENABLED=false
TELEPHONY_SPEECHKIT_API_KEY=

# Провайдер выжимок звонков: yandex или aiai.
TELEPHONY_SUMMARY_PROVIDER=yandex
# Для YandexGPT: ключ с ролью ai.languageModels.user и scope yc.ai.foundationModels.execute.
TELEPHONY_YANDEXGPT_ENABLED=false
TELEPHONY_YANDEXGPT_FOLDER_ID=
TELEPHONY_YANDEXGPT_API_KEY=
# Для AIAI.BY в режиме aiai используются эти параметры.
TELEPHONY_AIAI_API_KEY=
TELEPHONY_AIAI_BASE_URL=https://api.aiai.by/v1
TELEPHONY_AIAI_MODEL=gemini-2.5-flash-lite

# Входящий вебхук Bitrix24. Для выжимок нужны права crm и im, для отделов department и user_brief.
TELEPHONY_BITRIX_ENABLED=false
TELEPHONY_BITRIX_DIRECTORY_ENABLED=false
# Импорт контактов для локальных меток маршрутизации, каждые 15 минут.
TELEPHONY_BITRIX_CONTACTS_ENABLED=true
TELEPHONY_BITRIX_WEBHOOK_URL=
TELEPHONY_BITRIX_DEAL_CODE_FIELD=UF_CRM_1730705809359
# Ответственные для неизвестных номеров. Ключи — номера секторов, значения — ID сотрудников.
TELEPHONY_BITRIX_SECTOR_RECIPIENTS={}
# Запасной сотрудник, в том числе для сообщений без сектора.
# TELEPHONY_BITRIX_DEFAULT_RECIPIENT=42

# Межсервисный поиск объекта или шкафа. Секрет должен совпадать с TELEPHONY_API_SECRET в SavtAssist.
TELEPHONY_SAVTASSIST_BASE_URL=https://helper.savt.by
TELEPHONY_SAVTASSIST_API_SECRET=

# Номера и подписи в журнале звонков.
TELEPHONY_SECTOR_NUMBERS={}
TELEPHONY_EMPLOYEE_NAMES={}
# TELEPHONY_SECTOR_NAMES={"1":"Коммерческий","2":"Наладка","3":"Разработка ПО","4":"Проектирование","5":"Бухгалтерия"}
